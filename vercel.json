{
  "buildCommand": "vite build && esbuild server/vercel-handler.ts --bundle --platform=node --format=esm --outfile=api/index.js",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
